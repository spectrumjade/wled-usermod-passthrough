; Passthrough usermod - example build environment for a classic ESP32.
; Copy this section into platformio_override.ini in the WLED repository root.
;
; custom_usermods replaces the default list, so the defaults (AudioReactive) are kept via ${env:esp32dev.custom_usermods}.
; AudioReactive uses I2S0; passthrough uses I2S1 by default.
;
; Optional compile-time settings:
;   -D PASSTHROUGH_MAX_PIXELS=1024   largest input frame in pixels (3 frame buffers of 3 bytes per pixel)
;   -D PASSTHROUGH_DMA_BUFFERS=8     DMA ring size in 4 KB buffers (8 = 33 ms of samples at 8 MHz)

[env:esp32dev_passthrough]
extends = env:esp32dev
custom_usermods = ${env:esp32dev.custom_usermods}
  https://github.com/spectrumjade/wled-usermod-passthrough.git#v1.0.0
; local development: use a local checkout instead of the git URL
; custom_usermods = ${env:esp32dev.custom_usermods}
;   symlink:///path/to/wled-usermod-passthrough
;
; Each URL/symlink entry must be on its own (indented) line; WLED only recognizes it at the start of a line.
